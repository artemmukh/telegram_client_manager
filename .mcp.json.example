{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/user/PycharmProjects/PythonProject3"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
          "-y",
          "@upstash/context7-mcp"
        ],
      "env": {
      "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "sqlite": {
    "command": "uvx",
    "args": [
      "mcp-server-sqlite",
      "--db-path",
      "C:/Users/user/PycharmProjects/PythonProject3/data/data_base.db"
      ]
    },
    "yandex-maps": {
      "command": "node",
      "args": [
        "C:/Users/user/PycharmProjects/PythonProject3/mcp-servers/yandex-maps-mcp/dist/index.js"
      ],
      "env": {
        "YANDEX_MAPS_API_KEY": "${YANDEX_MAPS_API_KEY}",
        "YANDEX_MAPS_STATIC_API_KEY": "${YANDEX_MAPS_STATIC_API_KEY}"
      }
    }
  }
}