#!/usr/bin/env bash
# Installed as /usr/local/sbin/gha-zb-deploy-wrapper, root:root 0755.
# The deploy key's authorized_keys entry must force this command and disable
# port, agent, X11, and PTY forwarding.  Only `deploy <40-hex-sha>` is accepted.
set -euo pipefail

readonly DEPLOY_SCRIPT='/usr/local/lib/zb-deploy/deploy-zb'
readonly ORIGINAL_COMMAND="${SSH_ORIGINAL_COMMAND:-}"

if ((EUID != 0)); then
  printf 'gha-zb-deploy-wrapper: must be invoked through its restricted sudo rule\n' >&2
  exit 1
fi

if [[ "$ORIGINAL_COMMAND" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  exec "$DEPLOY_SCRIPT" "${BASH_REMATCH[1]}"
fi

printf 'gha-zb-deploy-wrapper: only deploy <lowercase-40-hex-sha> is allowed\n' >&2
exit 1
