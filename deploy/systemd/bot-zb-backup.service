[Unit]
Description=Verified OCI backup for Medical Appointment Telegram Bot ZB
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target bot-zb.service

[Service]
Type=oneshot
TimeoutStartSec=900
WorkingDirectory=/opt/telegram_client_manager
EnvironmentFile=/opt/telegram_client_manager/deploy/oci-backup.env
ExecStart=/usr/local/lib/zb-deploy/run-zb-backup
