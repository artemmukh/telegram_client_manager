# Copy to .env and fill in real values. Never commit the real .env.
BOT_INSTANCE=zb
BOT_TOKEN_ZB=replace_with_zb_bot_token
BOT_TOKEN_MM=replace_with_mm_bot_token
DATA_BASE=data/data_base.db
DATA_BASE_MM=data/data_base_mm.db
MISTRAL_API_KEY=replace_with_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
# Mini App web server (FastAPI/uvicorn)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Public https URL of the Mini App (e.g. via tunnel or reverse proxy)
WEBAPP_BASE_URL=https://example.com
# OpenRouter (reserved for phase 3 LLM features)
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=openrouter/auto
